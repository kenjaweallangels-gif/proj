# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.
POSTGRES_PASSWORD=change-me-strong-password
PLM_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PLM_SEED_DEMO=true                 # первая установка: демо-пользователи и изделие; затем false
PLM_CORS_ORIGINS=https://plm.corp.local

# ---- Локальная LLM (данные не покидают сеть) ---------------------------------------------
# Вариант А: модели УЖЕ запущены на этом ПК/сервере (Ollama, LM Studio, Jan, vLLM, GPT4All…) — укажите адрес их API.
#   Ollama          → http://host.docker.internal:11434/v1
#   LM Studio       → http://host.docker.internal:1234/v1   (в LM Studio включите Local Server; при необходимости «Serve on local network»)
#   Jan             → http://host.docker.internal:1337/v1
#   vLLM / webui    → http://host.docker.internal:8000/v1  или :5000/v1
#   Сервер на другом компьютере сети → http://192.168.x.x:ПОРТ/v1
# Название модели — ровно как показывает «Ещё → Пользователи, роли → ИИ-ассистент → Проверить подключение».
# Вариант Б: ничего не установлено → WITH_LLM=1 ./up.sh поднимет Ollama в контейнере и скачает модель (~9 ГБ).
PLM_LOCAL_LLM_ENABLED=false
PLM_LOCAL_LLM_URL=http://host.docker.internal:11434/v1
PLM_LOCAL_LLM_MODEL=qwen2.5:14b-instruct
PLM_LOCAL_LLM_API_KEY=                      # если сервер требует ключ (LM Studio/vLLM с --api-key); для Ollama пусто

# Облачная модель — только для неконфиденциальных запросов, по явному разрешению пользователя
PLM_CLOUD_LLM_ENABLED=false
PLM_ANTHROPIC_API_KEY=
PLM_CLOUD_LLM_MODEL=claude-opus-5-5

# Секреты интеграций (на них ссылаются конфиги коннекторов через поля *_env)
ONEC_PASSWORD=
ERP_DB_URL=
