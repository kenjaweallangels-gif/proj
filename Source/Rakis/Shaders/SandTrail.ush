// SandTrail.ush — следы на песке (T-017). Подключается Custom-нодами как /Project/Rakis/SandTrail.ush.
//
// Данные: два Render Target формата RG16f, рисует URakisSandTrailSubsystem (C++):
//   RT_SandTrail      — «ближний» каскад: 2048², 40.96 м вокруг игрока, 2 см/тексель (следы ног, тампер);
//   RT_SandTrail_Far  — «дальний» каскад: 1024², 204.8 м, 20 см/тексель (колея и кратер червя, тампер).
//   R = глубина вмятины, см (>= 0), G = высота вала (бровки), см (>= 0). Итоговая высота = G - R.
// Окно каскада: MPC_RakisWeather.TrailOrigin / TrailOriginFar = (центр X, центр Y, размер окна, активен 0/1), см.
// UV = (WorldPos.xy - Origin.xy) / Origin.z + 0.5 — то же отображение, что в C++ (WorldToPixel).
//
// Всё сэмплируется через SampleLevel(..., 0): функции работают и в пиксельном шейдере, и в WPO (вершинный),
// и в Nanite-displacement (там нет производных).
#pragma once

// ------------------------------------------------------------------------------------------------
// Форма штампа. UV — локальные координаты квада штампа [0,1]², +U — направление движения (носок).
// Type: 0 Footprint, 1 Sliding, 2 WormFurrow, 3 ThumperRing, 4 WormCrater (= ERakisStampType).
// Возвращает float2(вес вмятины 0..1, вес вала 0..1). Квад больше формы в ~1.3 раза — вал помещается.
// ------------------------------------------------------------------------------------------------
float2 RakisTrailStampShape(float2 UV, float Type)
{
	const float2 q = (UV * 2.0 - 1.0) * 1.3;
	float Depth = 0.0;
	float Rim = 0.0;

	if (Type < 0.5)
	{
		// След ноги (мягкая обувь/дистикомб): пятка + плюсна, перемычка-«талия». +X — носок.
		const float Heel = length((q - float2(-0.50, 0.0)) / float2(0.45, 0.62));
		const float Fore = length((q - float2(0.28, 0.0)) / float2(0.62, 0.78));
		const float D = min(Heel, Fore);
		Depth = 1.0 - smoothstep(0.55, 1.0, D);
		// Толчок носком: плюсна глубже пятки, песок выброшен вперёд (вал у носка выше).
		Depth *= lerp(0.8, 1.0, saturate(q.x + 0.5));
		Rim = smoothstep(0.88, 1.04, D) * (1.0 - smoothstep(1.04, 1.30, D));
		Rim *= 0.6 + 1.0 * saturate(q.x);
	}
	else if (Type < 1.5)
	{
		// Скольжение/съезд по склону: вытянутая борозда, песок сгребается вперёд.
		const float D = length(q / float2(1.0, 0.55));
		Depth = (1.0 - smoothstep(0.30, 1.0, D)) * lerp(0.6, 1.0, saturate(0.5 - q.x * 0.5));
		Rim = smoothstep(0.85, 1.05, D) * (1.0 - smoothstep(1.05, 1.30, D)) * (0.4 + saturate(q.x) * 1.2);
	}
	else if (Type < 2.5)
	{
		// Колея червя: круглый «бублик» с плавным профилем; цепочка штампов вдоль пути даёт сплошной жёлоб.
		const float D = length(q);
		const float Bowl = saturate(1.0 - D * D);
		Depth = Bowl * Bowl * (3.0 - 2.0 * Bowl);
		Rim = exp(-Pow2((D - 1.08) / 0.13));
	}
	else if (Type < 3.5)
	{
		// Тампер: лунка от штыря + кольцо «прыгающего» песка + затухающие концентрические волны.
		const float D = length(q);
		const float Hole = 1.0 - smoothstep(0.04, 0.12, D);
		const float Ring = exp(-Pow2((D - 0.70) / 0.08));
		Depth = max(Hole, Ring * 0.6);
		const float Waves = (0.5 + 0.5 * cos(D * 42.0)) * (1.0 - smoothstep(0.55, 1.0, D)) * smoothstep(0.12, 0.25, D);
		Rim = exp(-Pow2((D - 0.86) / 0.07)) * 0.7 + Waves * 0.35;
	}
	else
	{
		// Кратер выхода червя: глубокая чаша и мощный вал выброса.
		const float D = length(q);
		const float Bowl = saturate(1.0 - D * D);
		Depth = sqrt(Bowl);
		Rim = exp(-Pow2((D - 1.06) / 0.16));
	}
	return float2(saturate(Depth), saturate(Rim));
}

// ------------------------------------------------------------------------------------------------
// Ландшафт
// ------------------------------------------------------------------------------------------------
float RakisTrailWindowMask(float2 UV, float Active)
{
	// Последние 10 % окна с каждой стороны — плавное затухание (рецентровка не видна «рывком»).
	const float2 E = saturate((0.5 - abs(UV - 0.5)) * 10.0);
	return E.x * E.y * saturate(Active);
}

float RakisTrailHeight(Texture2D Tex, SamplerState TexSampler, float2 UV, float MaxDepth, float MaxRim)
{
	const float2 RG = Tex.SampleLevel(TexSampler, UV, 0).rg;
	return clamp(RG.g, 0.0, MaxRim) - clamp(RG.r, 0.0, MaxDepth);
}

// Высота и наклон одного каскада. Out: float3(dh/dx, dh/dy, h) в см/см и см, уже умноженные на маску окна.
float3 RakisTrailCascade(float3 WorldPos, Texture2D Tex, SamplerState TexSampler, float4 Origin,
                         float Texels, float MaxDepth, float MaxRim)
{
	const float Size = max(Origin.z, 1.0);
	const float2 UV = (WorldPos.xy - Origin.xy) / Size + 0.5;
	const float Mask = RakisTrailWindowMask(UV, Origin.w);
	float3 Result = 0.0;
	BRANCH
	if (Mask > 0.0)
	{
		const float T = 1.0 / max(Texels, 1.0);
		const float H  = RakisTrailHeight(Tex, TexSampler, UV, MaxDepth, MaxRim);
		const float HX1 = RakisTrailHeight(Tex, TexSampler, UV + float2(T, 0.0), MaxDepth, MaxRim);
		const float HX0 = RakisTrailHeight(Tex, TexSampler, UV - float2(T, 0.0), MaxDepth, MaxRim);
		const float HY1 = RakisTrailHeight(Tex, TexSampler, UV + float2(0.0, T), MaxDepth, MaxRim);
		const float HY0 = RakisTrailHeight(Tex, TexSampler, UV - float2(0.0, T), MaxDepth, MaxRim);
		const float TexelCm = Size * T;
		Result = float3((HX1 - HX0) / (2.0 * TexelCm), (HY1 - HY0) / (2.0 * TexelCm), H) * Mask;
	}
	return Result;
}

// Главная функция ландшафта.
//   P0 = (NearTexels, FarTexels, MaxDepthNearCm, MaxDepthFarCm), P1 = (MaxRimNearCm, MaxRimFarCm, -, -)
// Возвращает float4(dh/dx, dh/dy, HeightNearCm, HeightFarCm). Высоты < 0 — вмятины.
float4 RakisSandTrail(float3 WorldPos,
                      Texture2D NearTex, SamplerState NearTexSampler, float4 NearOrigin,
                      Texture2D FarTex, SamplerState FarTexSampler, float4 FarOrigin,
                      float4 P0, float4 P1)
{
	const float3 Near = RakisTrailCascade(WorldPos, NearTex, NearTexSampler, NearOrigin, P0.x, P0.z, P1.x);
	const float3 Far = RakisTrailCascade(WorldPos, FarTex, FarTexSampler, FarOrigin, P0.y, P0.w, P1.y);
	return float4(Near.xy + Far.xy, Near.z, Far.z);
}

// Нормаль (касательное ≈ мировое пространство ландшафта) из наклона следа. Strength — множитель крутизны.
float3 RakisTrailNormal(float2 Slope, float Strength)
{
	return normalize(float3(-Slope * Strength, 1.0));
}
