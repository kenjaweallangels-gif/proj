{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ar-assembly/operation.schema.json",
  "title": "Пакет операции AR-сборки",
  "type": "object",
  "required": ["schema_version", "operation", "anchors", "parts", "steps"],
  "additionalProperties": false,
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "pose": {
      "type": "object", "required": ["position"], "additionalProperties": false,
      "properties": { "position": { "$ref": "#/$defs/vec3" }, "rotation": { "$ref": "#/$defs/quat" } }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation": {
      "type": "object", "required": ["id", "title", "product"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "product": { "type": "string" },
        "revision": { "type": "string" }, "workplace": { "type": "string" }, "units": { "const": "mm" }
      }
    },
    "models": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "uri"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "uri": { "type": "string" }, "note": { "type": "string" } } }
    },
    "anchors": {
      "type": "object", "required": ["reference_frame", "markers"], "additionalProperties": false,
      "properties": {
        "reference_frame": { "type": "string" },
        "markers": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["id", "dictionary", "size_mm", "pose"], "additionalProperties": false,
            "properties": {
              "id": { "type": "integer" }, "dictionary": { "enum": ["DICT_6X6_250", "DICT_5X5_100", "DICT_4X4_50", "DICT_APRILTAG_36h11"] },
              "size_mm": { "type": "number", "exclusiveMinimum": 0 }, "pose": { "$ref": "#/$defs/pose" }, "note": { "type": "string" } } }
        },
        "check_distance": {
          "type": "object", "required": ["from", "to", "nominal_mm", "tol_mm"], "additionalProperties": false,
          "properties": { "from": { "$ref": "#/$defs/vec3" }, "to": { "$ref": "#/$defs/vec3" }, "nominal_mm": { "type": "number" }, "tol_mm": { "type": "number" } }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "designation", "name", "target"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "designation": { "type": "string" }, "name": { "type": "string" },
          "model": { "type": "string" }, "node": { "type": "string" }, "mass_kg": { "type": "number" },
          "fallback": { "type": "object", "required": ["type", "size_mm"], "additionalProperties": false,
            "properties": { "type": { "enum": ["box", "cylinder", "plate"] }, "size_mm": { "$ref": "#/$defs/vec3" }, "color": { "type": "string" } } },
          "target": { "$ref": "#/$defs/pose" },
          "source": { "type": "object", "required": ["kind"], "additionalProperties": false,
            "properties": { "kind": { "enum": ["cart", "bin", "rack", "lift", "bench"] }, "cell": { "type": "string" }, "position": { "$ref": "#/$defs/vec3" } } },
          "kd": { "type": "object", "required": ["sheet"], "additionalProperties": false,
            "properties": { "sheet": { "type": "string" }, "position": { "type": "string" } } }
        }
      }
    },
    "fasteners": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "type", "designation", "position", "axis"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "type": { "enum": ["bolt", "nut", "washer", "rivet", "qpin", "cpin", "cotter", "qturn", "clip", "screw"] },
          "designation": { "type": "string" }, "part": { "type": "string" },
          "position": { "$ref": "#/$defs/vec3" }, "axis": { "$ref": "#/$defs/vec3" },
          "torque_nm": { "type": "number" }, "lock": { "enum": ["self_locking_nut", "cotter", "wire", "none"] }, "new_only": { "type": "boolean" }
        }
      }
    },
    "kd_sheets": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "uri", "title"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "uri": { "type": "string" }, "title": { "type": "string" },
          "positions": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } } } }
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "n", "title", "kind"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "n": { "type": "integer", "minimum": 1 }, "title": { "type": "string" },
          "kind": { "enum": ["align", "install", "fasten", "adjust", "check", "photo"] },
          "parts": { "type": "array", "items": { "type": "string" } }, "fasteners": { "type": "array", "items": { "type": "string" } },
          "tool": { "type": "string" }, "params": { "type": "object" },
          "check": { "type": "object", "required": ["type"], "additionalProperties": false,
            "properties": { "type": { "enum": ["gap", "torque", "visual", "lock", "flush"] }, "nominal_mm": { "type": "number" }, "tol_mm": { "type": "number" }, "text": { "type": "string" } } },
          "critical": { "type": "boolean" }, "confirm": { "enum": ["voice", "button", "value", "photo"] },
          "norm_s": { "type": "number" }, "kd": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }
        }
      }
    }
  }
}
