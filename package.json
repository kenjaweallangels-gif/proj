{
  "name": "orbital-station",
  "version": "1.0.0",
  "description": "",
  "main": "desktop/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shot": "node tools/screenshot.mjs",
    "smoke": "node tools/smoke.mjs",
    "demo": "node tools/demo.mjs",
    "desktop": "vite build && electron .",
    "desktop:run": "electron .",
    "desktop:gpu-info": "electron . --gpu-info",
    "desktop:selftest": "vite build && node desktop/tools/selftest.mjs",
    "desktop:icon": "node desktop/tools/make-icon.mjs",
    "dist:linux": "vite build && node desktop/tools/make-icon.mjs --if-missing && electron-builder --config desktop/electron-builder.yml --linux AppImage deb dir --x64 --publish never",
    "dist:win": "vite build && node desktop/tools/make-icon.mjs --if-missing && electron-builder --config desktop/electron-builder.yml --win portable nsis dir --x64 --publish never",
    "dist:mac": "vite build && node desktop/tools/make-icon.mjs --if-missing && electron-builder --config desktop/electron-builder.yml --mac dir dmg --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenjaweallangels-gif/proj.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kenjaweallangels-gif/proj/issues"
  },
  "homepage": "https://github.com/kenjaweallangels-gif/proj#readme",
  "type": "module",
  "private": "true",
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "vite": "^8.3.5",
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "desktopName": "orbital-station-aurora.desktop"
}
